{
    "REQUIRED_API_KEY": "123456",
    "SERVER_PORT": 3000,
    "HOST": "0.0.0.0",
    "MODEL_PROVIDER": "gemini-cli-oauth",
    "SYSTEM_PROMPT_FILE_PATH": "configs/input_system_prompt.txt",
    "SYSTEM_PROMPT_MODE": "overwrite",
    "SYSTEM_PROMPT_REPLACEMENTS": [
        { "old": "Old text to replace", "new": "New replacement text" },
        { "old": "AI", "new": "Smart Bot" }
    ],
    "PROMPT_LOG_BASE_NAME": "prompt_log",
    "PROMPT_LOG_MODE": "none",
    "REQUEST_MAX_RETRIES": 3,
    "REQUEST_BASE_DELAY": 1000,
    "RATE_LIMIT_COOLDOWN_ENABLED": false,
    "RATE_LIMIT_COOLDOWN_MS": 30000,
    "RATE_LIMIT_COOLDOWN_JITTER_MS": 5000,
    "RATE_LIMIT_COOLDOWN_MAX_MS": 300000,
    "CRON_NEAR_MINUTES": 1,
    "CRON_REFRESH_TOKEN": false,
    "PROVIDER_POOLS_FILE_PATH": "configs/provider_pools.json",
    "CUSTOM_MODELS_FILE_PATH": "configs/custom_models.json",
    "DETECTED_MODELS_FILE_PATH": "configs/detected_models.json",
    "MAX_ERROR_COUNT": 3,
    "GROK_COOKIE_TOKEN": "your-sso-cookie-token",
    "GROK_CF_CLEARANCE": "your-cf-clearance-cookie",
    "GROK_USER_AGENT": "Mozilla/5.0 ...",
    "GROK_BASE_URL": "https://grok.com",
    "providerFallbackChain": {
      "gemini-cli-oauth": ["gemini-antigravity"],
      "gemini-antigravity": ["gemini-cli-oauth"],
      "claude-kiro-oauth": ["claude-custom"],
      "claude-custom": ["claude-kiro-oauth"]
    },
    "modelFallbackMapping": {
      "gemini-claude-opus-4-5-thinking": {
        "targetProviderType": "claude-kiro-oauth",
        "targetModel": "claude-opus-4-5"
      },
      "gemini-claude-sonnet-4-5-thinking": {
        "targetProviderType": "claude-kiro-oauth", 
        "targetModel": "claude-sonnet-4-5"
      },
      "gemini-claude-sonnet-4-5": {
        "targetProviderType": "claude-kiro-oauth",
        "targetModel": "claude-sonnet-4-5"
      },
      "claude-opus-4-5": {
        "targetProviderType": "gemini-antigravity",
        "targetModel": "gemini-claude-opus-4-5-thinking"
      },
      "claude-sonnet-4-5": {
        "targetProviderType": "gemini-antigravity",
        "targetModel": "gemini-claude-sonnet-4-5"
      }
    },
    "PROXY_URL": "http://127.0.0.1:1089",
    "PROXY_ENABLED_PROVIDERS": [
            "gemini-cli-oauth",
            "gemini-antigravity"
    ],
    "LOG_ENABLED": true,
    "LOG_OUTPUT_MODE": "all",
    "LOG_LEVEL": "info",
    "LOG_DIR": "logs",
    "LOG_INCLUDE_REQUEST_ID": true,
    "LOG_INCLUDE_TIMESTAMP": true,
    "LOG_MAX_FILE_SIZE": 10485760,
    "LOG_MAX_FILES": 10,
    "TLS_SIDECAR_ENABLED": false,
    "TLS_SIDECAR_PORT": 9090,
    "UI_ENABLED": true,

    "_OUTPUT_RESERVE_NOTES_": "Kiro 输出截断缓解 (参考 cursor2api v2.7.8)。全部默认关闭；仅作用于 claude-kiro-oauth provider。详见 docs/pending-plans/compress the inputs/。",
    "OUTPUT_RESERVE_CONTEXT_PRESSURE": 1.0,
    "OUTPUT_RESERVE_TOOL_RESULT_TRUNCATE": false,
    "OUTPUT_RESERVE_TOOL_RESULT_MAX_CHARS": 8192,
    "OUTPUT_RESERVE_TOOL_DESC_ADAPTIVE": false,

    "_KIRO_MODEL_CAPABILITIES_NOTES_": "按 model-id 控制 Kiro 行为。nativeThinking: 是否下发 additionalModelRequestFields(thinking)，省略时按版本自动判定 (Claude >= 4.7；实测 4.5/4.6 会返回 400 'not supported for this model'，故自动跳过)。contextCompression: false 时对该模型跳过工具结果截断 + 工具描述自适应缩短 (适合 opus-4.7/4.8 等 1M 上下文模型)，省略时默认 true。key 可用上游 id (claude-opus-4.7) 或客户端 id；'default' 作用于所有未单列模型；per-model 优先级高于 default。整体省略该配置则全部走版本默认。",
    "KIRO_MODEL_CAPABILITIES": {
        "claude-opus-4.7": { "contextCompression": false },
        "claude-opus-4.8": { "contextCompression": false }
    },

    "_tokenBufferReserve_NOTES_": "Kiro 历史裁剪的 token 缓冲预留。裁剪上限 = 模型上下文 - tokenBufferReserve，给 currentMessage + tools + 输出留空间。省略时默认 50000，取值会被 clamp 到 [5000, 150000]。仅作用于 claude-kiro-oauth provider。",
    "tokenBufferReserve": 50000,
    "_TOOL_DESCRIPTION_REPLACEMENTS":"用于替换工具描述. 内容中的换行必须使用\n来进行替换,不能写真换行",
    "TOOL_DESCRIPTION_REPLACEMENTS": [
      { "tool": "Bash", "old": "git push --force", "new": "(redacted)" },
      { "tool": "Bash", "old": "long boilerplate paragraph...", "new": "" },
      { "tool": "Read", "old": "By default, it reads up to 2000 lines", "new": "Reads up to 2000 lines" }
    ]
}
